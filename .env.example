# Camera
CAMERA_INDEX=0
CAMERA_ROTATION=180

# MQTT / EMQX
EMQX_HOST=your-cluster.emqx.cloud
EMQX_PORT=8883
EMQX_USERNAME=pi_device
EMQX_PASSWORD=your_password
EMQX_TLS=true
MQTT_TRANSPORT=tcp
MQTT_WS_PATH=/mqtt
MQTT_TOPIC=test/connection
MQTT_QOS=1
MQTT_CLIENT_ID=raspi-somnoalert-001
MQTT_CA_CERT_PATH=
VEHICLE_ID=truck_042
DRIVER_ID=driver_007

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
SUPABASE_DB_PASSWORD=your_db_password
SUPABASE_PROJECT_ID=your_project_id
SUPABASE_SCHEMA=public

# Local queue storage
SQLITE_QUEUE_PATH=somnolencia_queue.db

# --- Precision de la deteccion de somnolencia (endurecimiento del modelo) ---
# Todos tienen defaults sensatos; se afinan con tools/validate_precision.py.
#
# Estabilizador de nivel (corroboracion multi-cue + persistencia + histeresis):
SOMNO_TUP_1_S=1.0            # seg. sostenidos para comprometer subir a FATIGA
SOMNO_TUP_2_S=1.5            # ...a SOMNOLENCIA
SOMNO_TUP_3_S=2.0            # ...a CRITICO
SOMNO_TUP_4_S=2.5            # ...a EMERGENCIA
SOMNO_TDOWN_S=1.2            # seg. para confirmar una bajada de nivel
SOMNO_CORROB_WINDOW_S=12     # ventana para corroborar familias de cues
SOMNO_CORROB_MIN_LEVEL=3     # nivel a partir del cual se exige corroboracion
SOMNO_CORROB_MIN_FAMILIES=2  # familias primarias distintas para niveles altos
SOMNO_SINGLE_FAMILY_CAP=2    # tope de nivel con una sola familia (sin microsueno)
SOMNO_FACE_QUALITY_MIN=0.30  # estabilidad minima de landmarks (rostro valido)
#
# Umbrales de metricas oculares (literatura: PERCLOS P80 FHWA, microsueno):
SOMNO_PERCLOS_CLOSE_FRAC=0.80   # criterio P80 (ojo >=80% cerrado)
SOMNO_PERCLOS_CLOSED_FLOOR=0.08 # EAR de ojo totalmente cerrado
SOMNO_PERCLOS_ONSET=0.15        # umbral de somnolencia (15% del tiempo)
SOMNO_PERCLOS_SEVERE=0.30       # somnolencia marcada
SOMNO_MICROSLEEP_MS=500         # inicio de microsueno / lapso de atencion (ms)
#
# Fiabilidad por POSE de cabeza (evita falsos positivos al virar/inclinar la
# cara: fuera de estos rangos, en grados vs neutro calibrado, se suprimen los
# eventos oculares/boca porque la geometria 2D se escorza):
SOMNO_YAW_OCULAR_MAX=38    # giro maximo para fiar de EAR/parpadeo/PERCLOS
SOMNO_PITCH_OCULAR_MAX=28  # cabeceo maximo para fiar de metricas oculares
SOMNO_ROLL_OCULAR_MAX=35   # inclinacion lateral maxima para metricas oculares
SOMNO_YAW_MOUTH_MAX=45     # giro maximo para fiar del MAR/bostezo
SOMNO_PITCH_MOUTH_MAX=32   # cabeceo maximo para fiar del MAR/bostezo
SOMNO_EAR_YAW_SOFT=12      # yaw donde empieza a ponderarse el ojo mas frontal
SOMNO_EAR_YAW_HARD=30      # yaw donde solo se usa el ojo frontal
#
# Distraccion / mirada fuera de via (senal independiente, NO altera el score):
SOMNO_DISTRACTION_ENABLED=1     # 1=marcar distraccion por giro sostenido
SOMNO_DISTRACTION_YAW=40        # giro (grados) que se considera mirar fuera de via
SOMNO_DISTRACTION_MIN_S=2.5     # seg. de giro sostenido para marcar distraccion
SOMNO_DISTRACTION_BUZZER=1      # 1=aviso audible (chirp breve) en distraccion
SOMNO_DISTRACTION_RECHIRP_S=3.0 # seg. entre re-avisos mientras persista
#
# Landmarks de iris (EAR mas estable); poner 0 si el FPS cae en la Pi:
SOMNO_REFINE_LANDMARKS=1
#
# Calibracion: persistencia por conductor y robustez:
SOMNO_FORCE_CALIB=0             # 1=ignorar calibracion guardada y recalibrar
SOMNO_CALIB_MAX_AGE_S=604800    # edad max. de una calibracion para reusarla (7 dias)
#
# Condiciones adversas (endurecen el umbral de cierre para evitar falsos):
SOMNO_MIN_ILLUMINATION=0.12     # luz min. DE LA CARA (recuadro, no del fondo); debajo=suprime
SOMNO_GLASSES=0                 # 1=conductor con lentes (ajuste manual)
SOMNO_NIGHT_CLOSE_SCALE=0.90    # factor de close_thr en modo noche (auto por luz)
SOMNO_GLASSES_CLOSE_SCALE=0.90  # factor de close_thr con lentes
SOMNO_GLASSES_PERCLOS_FLOOR=0.02 # sube el piso de cierre del PERCLOS con lentes
#
# Perdida breve de rostro (histeresis): no borrar datos al quitar/poner la cara:
SOMNO_FACE_GRACE_S=4.0       # seg. de gracia congelando score y nivel
SOMNO_FACE_DECAY_PER_S=3.0   # decaimiento gradual del score tras la gracia (pts/s)
SOMNO_RESTORE_SCORE_CAP=35   # tope del score al reiniciar (evita alerta alta heredada)
SOMNO_RECOVERY_GRACE_S=300   # seg. sin eventos antes de recuperar (histeresis >=5 min)
SOMNO_RECOVERY_PER_S=3.0     # velocidad de recuperacion del score (pts/seg, indep. FPS)
SOMNO_EYE_CLOSED_EMERGENCY_MS=2000  # ojos cerrados => alarma/buzzer (2 s)
#
# Grabacion de sesiones para validar precision (1=activar):
SOMNO_RECORD_SESSION=0
SOMNO_RECORD_DIR=recordings
